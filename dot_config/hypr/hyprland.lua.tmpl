for _, spec in ipairs(MONITORS) do
    hl.monitor(spec)
end

for ws = 1, WORKSPACES do
    hl.workspace_rule({ workspace = tostring(ws), persistent = true, monitor = WORKSPACE_OUTPUT[ws] })
end

local function placeExternalWorkspaces()
    if not TOP_EXTERNALS then return end
    local monitors = hl.get_monitors()
    local target
    for _, desc in ipairs(TOP_EXTERNALS) do
        for _, m in ipairs(monitors) do
            if m.description == desc then target = m break end
        end
        if target then break end
    end
    if not target then
        local externals = {}
        for _, m in ipairs(monitors) do
            if not m.name:match("^eDP") then table.insert(externals, m) end
        end
        if #externals == 1 then target = externals[1] end
    end
    if not target then return end

    local focused = hl.get_active_monitor()
    for ws = 6, 10 do
        hl.dispatch(hl.dsp.workspace.move({ workspace = ws, monitor = target.name }))
    end
    hl.dispatch(hl.dsp.focus({ monitor = target.name }))
    hl.dispatch(hl.dsp.focus({ workspace = 6 }))
    if focused then
        hl.dispatch(hl.dsp.focus({ monitor = focused.name }))
    end
end

hl.on("monitor.added", function()
    -- give the new output a moment to be fully set up
    hl.timer(placeExternalWorkspaces, { timeout = 500, type = "oneshot" })
end)


