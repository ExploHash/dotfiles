---- WINDOWS AND WORKSPACES ----
--------------------------------

hl.window_rule({
    name  = "float-smol-windows",
    match = { class = "^(smolkitty)$" },

    float = true,
    size  = "800 600",
    move  = "100 100",
})

hl.window_rule({
    -- Ignore maximize requests from all apps
    name  = "suppress-maximize-events",
    match = { class = ".*" },

    suppress_event = "maximize",
})

hl.window_rule({
    -- Fix some dragging issues with XWayland
    name  = "fix-xwayland-drags",
    match = {
        class      = "^$",
        title      = "^$",
        xwayland   = true,
        float      = true,
        fullscreen = false,
        pin        = false,
    },

    no_focus = true,
})

hl.window_rule({
    name  = "increase-touchpad-scrolling-speed-kitty",
    match = { class = "^(kitty)$" },

    scroll_touchpad = 4,
})
