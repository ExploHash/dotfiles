------------------
---- MONITORS ----
------------------

-- Per-machine setup (chezmoi template):
--   MONITORS         monitor specs, applied in order
--   WORKSPACES       number of persistent workspaces
--   WORKSPACE_OUTPUT workspace -> monitor it lives on
--   FKEY_WORKSPACES  true: 1-5 on number keys, 6+ on F1-F10; false: 1-9,0 on number keys
--   TOP_EXTERNALS    if set, workspaces 6-10 follow the first of these monitors that is
--                    connected, or the only external monitor if exactly one is connected
local MONITORS, WORKSPACES, WORKSPACE_OUTPUT, FKEY_WORKSPACES, TOP_EXTERNALS
local function wsRange(from, to, output)
    for ws = from, to do WORKSPACE_OUTPUT[ws] = output end
end

